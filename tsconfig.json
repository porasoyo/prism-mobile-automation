{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node", "mocha", "@wdio/types", "webdriverio", "chai"]
  },
  "include": [
    "src/**/*.ts",
    "wdio.*.conf.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".backup",
    "**/*.backup.*"
  ],
  "ts-node": {
    "transpileOnly": true,
    "files": true
  }
}